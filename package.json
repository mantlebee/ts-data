{
  "name": "@mantlebee/ts-data",
  "version": "1.1.0",
  "description": "Models and utils to navigate and interact with data.",
  "main": "dist/index.js",
  "module": "dist/esm/index.mjs",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "rimraf dist && rollup --config && tsc-alias",
    "coverage": "jest --coverage",
    "doc": "typedoc",
    "doc:publish": "npm run doc && node ./gh-pages.js",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mantlebee/ts-data.git"
  },
  "keywords": [
    "typescript",
    "data",
    "data-source",
    "filtering",
    "pagination",
    "sorting",
    "query"
  ],
  "author": "MantleBee",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mantlebee/ts-data/issues"
  },
  "homepage": "https://github.com/mantlebee/ts-data#readme",
  "peerDependencies": {
    "@mantlebee/ts-core": "^1.2.1"
  },
  "devDependencies": {
    "@mantlebee/ts-core": "^1.2.1",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/jest": "30.0.0",
    "gh-pages": "6.3.0",
    "jest": "30.5.1",
    "jest-environment-jsdom": "30.5.1",
    "rimraf": "6.1.3",
    "rollup": "4.63.1",
    "ts-jest": "29.4.12",
    "tsc-alias": "1.9.3",
    "tslib": "2.8.1",
    "typedoc": "0.28.20",
    "typescript": "5.9.3"
  }
}
