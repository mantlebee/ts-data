{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "declaration": true,
    "declarationDir": "dist/src",
    "esModuleInterop": true,
    "importHelpers": true,
    "module": "ES6",
    "moduleResolution": "node",
    "outDir": "dist/src",
    "paths": {
      "@/*": ["src/*"],
      "@test/*": ["test/*"]
    },
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES6",
    "types": ["jest", "node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules"]
}
